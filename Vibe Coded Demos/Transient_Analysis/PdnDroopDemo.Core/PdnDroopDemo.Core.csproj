<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>PdnDroopDemo</RootNamespace>
    <AssemblyName>PdnDroopDemo.Core</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <!--
    These are the NI-SCOPE and NI-DCPower .NET assemblies installed on this
    machine (driver 26.5, Fx40 build). Fx40 is the build for .NET Framework,
    which is why this library targets net48 and not .NET 8. Private=False
    keeps the build from copying them next to the exe; the GAC already has them.
  -->
  <ItemGroup>
    <Reference Include="System.Management" />
    <Reference Include="Ivi.Driver">
      <HintPath>C:\Program Files\IVI Foundation\IVI\Microsoft.NET\Framework64\v2.0.50727\IviFoundationSharedComponents 2.0.0\Ivi.Driver.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="NationalInstruments.Common">
      <HintPath>C:\Windows\Microsoft.NET\assembly\GAC_MSIL\NationalInstruments.Common\v4.0_19.1.40.49152__dc6ad606294fc298\NationalInstruments.Common.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="NationalInstruments.ModularInstruments.Common">
      <HintPath>C:\Program Files\IVI Foundation\IVI\Microsoft.NET\Framework64\v4.0.30319\NationalInstruments.ModularInstruments.Common 26.5.0\NationalInstruments.ModularInstruments.Common.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="NationalInstruments.ModularInstruments.NIScope.Fx40">
      <HintPath>C:\Program Files\IVI Foundation\IVI\Microsoft.NET\Framework64\v4.0.30319\NationalInstruments.ModularInstruments.NIScope 26.5.0\NationalInstruments.ModularInstruments.NIScope.Fx40.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="NationalInstruments.ModularInstruments.NIDCPower.Fx40">
      <HintPath>C:\Program Files\IVI Foundation\IVI\Microsoft.NET\Framework64\v4.0.30319\NationalInstruments.ModularInstruments.NIDCPower 26.5.0\NationalInstruments.ModularInstruments.NIDCPower.Fx40.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="NationalInstruments.SystemConfiguration">
      <HintPath>C:\Program Files\National Instruments\NI Hardware Configuration\NationalInstruments.SystemConfiguration.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
</Project>
