# .gitignore for PXI_Power_Rail_HandsOn
# Place this file in the repo root: C:\git\PXI_Power_Rail_HandsOn\.gitignore

# ---------------------------------------------------------------
# ESP-IDF firmware source projects (firmware\)
# Full build output is large (~190 MB per project) and is
# regenerated by "idf.py build". Keep each project's sdkconfig.
# ---------------------------------------------------------------
firmware/*/build/
firmware/*/managed_components/
firmware/*/sdkconfig.old

# ---------------------------------------------------------------
# Station package (PXI_Training\)
# Keep only what esptool needs to flash: flash_args and the .bin
# files it lists. Everything else in each build folder is ignored.
# ---------------------------------------------------------------
PXI_Training/exercises/*/build/**
!PXI_Training/exercises/*/build/**/
!PXI_Training/exercises/*/build/flash_args
!PXI_Training/exercises/*/build/**/*.bin

# ---------------------------------------------------------------
# Python demo (Vibe Coded Demos\Brownout_Threshold)
# ---------------------------------------------------------------
__pycache__/
*.pyc
.venv/
venv/
*.log
# Dated sweep results written by the demo scripts
Vibe Coded Demos/Brownout_Threshold/brownout_sweep_*.csv

# ---------------------------------------------------------------
# C# demo (Vibe Coded Demos\Transient_Analysis)
# Visual Studio build output is ignored, but the prebuilt
# release\ folder IS committed so FAEs can run Demo B without
# building. Do not add a "[Rr]elease/" rule here.
# ---------------------------------------------------------------
**/bin/
**/obj/
.vs/
*.user
*.suo

# ---------------------------------------------------------------
# Videos are hosted elsewhere (SharePoint/Stream) and linked
# from the README, not stored in git.
# ---------------------------------------------------------------
*.mp4
*.mov
*.mkv
*.avi

# ---------------------------------------------------------------
# Windows and Office clutter
# ---------------------------------------------------------------
Thumbs.db
desktop.ini
~$*
